{
  "Comment": "VulnBoard AI Security Agent - Step Functions",
  "StartAt": "Orchestrator",
  "States": {
    "Orchestrator": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-northeast-2:683123960885:function:vulnboard-orchestrator",
      "Next": "CheckShouldBlock",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Failed"
        }
      ]
    },
    "CheckShouldBlock": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.decision.should_block",
          "BooleanEquals": true,
          "Next": "Detection"
        }
      ],
      "Default": "NoAction"
    },
    "Detection": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-northeast-2:683123960885:function:vulnboard-detection",
      "Next": "Analysis",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Failed"
        }
      ]
    },
    "Analysis": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-northeast-2:683123960885:function:vulnboard-analysis",
      "Next": "Automation",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Failed"
        }
      ]
    },
    "Automation": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-northeast-2:683123960885:function:vulnboard-automation",
      "Next": "Report",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Failed"
        }
      ]
    },
    "Report": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-northeast-2:683123960885:function:vulnboard-report",
      "Next": "Done",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Failed"
        }
      ]
    },
    "NoAction": {
      "Type": "Succeed"
    },
    "Done": {
      "Type": "Succeed"
    },
    "Failed": {
      "Type": "Fail",
      "Error": "AgentError",
      "Cause": "Agent 실행 중 오류 발생"
    }
  }
}
